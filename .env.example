# Copy to .env and replace the placeholders. Never commit .env.
# Choose one upload mode: DataWay + token, or DataKit.

# DataWay
SAMPLE_DATAWAY_URL='https://dataway.example.com'
SAMPLE_CLIENT_TOKEN='replace-with-client-token'

# DataKit: comment out both DataWay settings above before enabling this.
# SAMPLE_DATAKIT_URL='http://192.168.1.100:9529'

# Configure at least one platform. Leave an unused platform empty.
SAMPLE_ANDROID_APP_ID='replace-with-android-rum-app-id'
SAMPLE_IOS_APP_ID='replace-with-ios-rum-app-id'

SAMPLE_SERVICE_NAME='cocos-hybrid-sample'
SAMPLE_ENV='demo'
SAMPLE_DEBUG='true'
