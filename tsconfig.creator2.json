{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES5",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2015",
      "DOM"
    ],
    "rootDir": "src",
    "outDir": "packages/cocos/dist/creator2",
    "sourceMap": true,
    "inlineSources": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/creator2/**/*.ts",
    "src/web/**/*.ts",
    "src/native/**/*.ts"
  ],
  "exclude": [
    "src/web/creator3.ts"
  ]
}
