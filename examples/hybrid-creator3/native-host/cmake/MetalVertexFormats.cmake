# Creator 3.8.8 omits unsigned-byte vertex formats from its Metal converter.
# Build a corrected translation unit for this sample without editing Creator.
if(NOT CC_USE_METAL OR NOT TARGET ${ENGINE_NAME})
    return()
endif()

# The bundled enoki headers specialize standard traits rejected by newer Xcode.
if(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang" AND CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 17)
    target_compile_options(${ENGINE_NAME} PRIVATE -Wno-invalid-specialization)
endif()

set(_sample_metal_source "${COCOS_X_PATH}/cocos/renderer/gfx-metal/MTLUtils.mm")
file(READ "${_sample_metal_source}" _sample_metal_code)
string(FIND "${_sample_metal_code}" "MTLVertexFormat mu::toMTLVertexFormat(" _sample_vertex_start)
string(FIND "${_sample_metal_code}" "Format mu::convertGFXPixelFormat(" _sample_vertex_end)
if(_sample_vertex_start EQUAL -1 OR _sample_vertex_end LESS _sample_vertex_start)
    message(FATAL_ERROR "Unrecognized Metal vertex converter boundaries")
endif()
math(EXPR _sample_vertex_length "${_sample_vertex_end} - ${_sample_vertex_start}")
string(SUBSTRING "${_sample_metal_code}" ${_sample_vertex_start} ${_sample_vertex_length} _sample_vertex_original)
set(_sample_vertex_code "${_sample_vertex_original}")
foreach(_sample_format RG8 RGB8 RGBA8)
    if(NOT _sample_vertex_code MATCHES "case Format::${_sample_format}UI:")
        set(_sample_case "case Format::${_sample_format}: return")
        string(FIND "${_sample_vertex_code}" "${_sample_case}" _sample_case_offset)
        if(_sample_case_offset EQUAL -1)
            message(FATAL_ERROR "Unrecognized Metal vertex converter: ${_sample_format}")
        endif()
        string(REPLACE "${_sample_case}"
            "case Format::${_sample_format}UI:\n        ${_sample_case}"
            _sample_vertex_code "${_sample_vertex_code}")
    endif()
endforeach()
string(REPLACE "${_sample_vertex_original}" "${_sample_vertex_code}" _sample_metal_code "${_sample_metal_code}")

set(_sample_metal_copy "${CMAKE_CURRENT_BINARY_DIR}/sample-engine/MTLUtils.mm")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/sample-engine")
file(WRITE "${_sample_metal_copy}" "${_sample_metal_code}")
get_target_property(_sample_engine_sources ${ENGINE_NAME} SOURCES)
set(_sample_engine_updated)
set(_sample_metal_replaced FALSE)
foreach(_sample_source IN LISTS _sample_engine_sources)
    if(_sample_source MATCHES "(^|/)MTLUtils\\.mm$")
        list(APPEND _sample_engine_updated "${_sample_metal_copy}")
        set(_sample_metal_replaced TRUE)
    else()
        list(APPEND _sample_engine_updated "${_sample_source}")
    endif()
endforeach()
if(NOT _sample_metal_replaced)
    message(FATAL_ERROR "Cannot locate the sample engine's Metal converter translation unit")
endif()
set_property(TARGET ${ENGINE_NAME} PROPERTY SOURCES "${_sample_engine_updated}")
target_include_directories(${ENGINE_NAME} PRIVATE "${COCOS_X_PATH}/cocos/renderer/gfx-metal")
set_source_files_properties("${_sample_metal_copy}" PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
