/node_modules/
/packages/*/dist/
/packages/*/native/
/packages/*/extension/
/packages/*/components/
/artifacts/
/coverage/
/.idea/
*.iml

# Machine-local environment files. Commit only sanitized *.example templates.
.env
.env.*
!.env.example

# Generated from SAMPLE_* environment variables; may contain credentials.
*.generated.ts*
/examples/hybrid-creator*/assets/resources/sample-webview.generated.json*

# Local diagnostic projects and experiments; maintained samples live in hybrid-creator{2,3}.
/examples/creator2/
/examples/creator3/
/examples/creator2-app/
/examples/shared/
/examples/native-host/
/examples/hybrid-creator3/assets/ReplayTrafficBenchmark.ts*
/examples/hybrid-creator3/native-host/android/PerfectHybridReplayUploader.java
/scripts/*replay-traffic*
/test/diagnostic-sample.test.ts
/test/replay-traffic-benchmark.test.ts

# Staged into the publishable workspace by npm run build.
/packages/cocos/LICENSE
/packages/cocos/THIRD_PARTY_NOTICES

# Local agent guidance and implementation notes (do not commit).
/AGENTS.md
/docs/

# Customer environment reports are local diagnostic artifacts.
cocos-env*.json

*.tgz
.DS_Store

# Generated assets for both publishable packages.
/packages/*/extensions/
/packages/*/bin/
/packages/*/LICENSE
/packages/*/THIRD_PARTY_NOTICES

# Generated Web bootstrap bundle.
/packages/cocos/web/bootstrap.js*

# Platform runtime bundled outside the game module graph.
/packages/cocos/runtime/

/packages/cocos-session-replay/runtime/
