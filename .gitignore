/node_modules/
/packages/*/dist/
/packages/*/native/
/packages/*/extension/
/packages/*/components/
/artifacts/
/coverage/
/.idea/
*.iml

# Machine-local environment files. Commit only sanitized *.example templates.
.env
.env.*
!.env.example

# Generated from SAMPLE_* environment variables; may contain credentials.
*.generated.ts*

# Local diagnostic projects and experiments; maintained samples live in hybrid-creator{2,3}.
/examples/creator2/
/examples/creator3/
/examples/creator2-app/
/examples/shared/
/examples/native-host/
