{
  "name": "cocos-sdk-workspace",
  "version": "0.1.0-alpha.4",
  "description": "Observability SDK integration workspace for Cocos Creator",
  "private": true,
  "license": "Apache-2.0",
  "author": "TrueWatch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrueWatchTech/datakit-cocos.git"
  },
  "homepage": "https://github.com/TrueWatchTech/datakit-cocos#readme",
  "bugs": {
    "url": "https://github.com/TrueWatchTech/datakit-cocos/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:creator2 && npm run build:creator3 && node scripts/stage-package-assets.mjs",
    "build:creator2": "tsc -p tsconfig.creator2.json",
    "build:creator3": "tsc -p tsconfig.creator3.json",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "sample:configure": "node scripts/configure-sample.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify": "npm run verify:release && npm run typecheck && npm test && npm run test:release-policy && npm run build",
    "test:release-policy": "node --test scripts/test-release-policy.cjs scripts/test-publish-preflight.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
