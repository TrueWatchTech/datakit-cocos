{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@truewatchtech/cocos-sdk/plugin-api": [
        "src/core/plugin-api.ts"
      ]
    }
  },
  "include": [
    "src/core/**/*.ts",
    "test/**/*.ts",
    "src/session-replay/core/**/*.ts"
  ]
}
