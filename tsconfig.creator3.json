{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": [
      "ES2018",
      "DOM"
    ],
    "rootDir": "src",
    "outDir": "packages/cocos/dist/creator3",
    "sourceMap": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/creator3/**/*.ts",
    "src/web/**/*.ts",
    "src/native/**/*.ts"
  ],
  "exclude": [
    "src/web/creator2.ts"
  ]
}
