{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": [
      "ES2018",
      "DOM"
    ],
    "rootDir": "src/session-replay",
    "outDir": "packages/cocos-session-replay/dist/creator3",
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@truewatchtech/cocos-sdk/plugin-api": [
        "packages/cocos/dist/creator3/core/plugin-api.d.ts"
      ]
    }
  },
  "include": [
    "src/session-replay/core/**/*.ts",
    "src/session-replay/creator3/**/*.ts"
  ]
}
